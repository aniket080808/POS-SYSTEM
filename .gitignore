# =====================
# ENVIRONMENT VARIABLES
# =====================
# Ignore actual .env files with real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.envrc

# But keep .env.example tracked (it's a template, not credentials)
!.env.example

# =====================
# BUILD ARTIFACTS
# =====================

# Java / Maven (pos-backend)
target/
*.jar
*.war
*.ear
*.class
.factorypath

# Node / Vite (pos-frontend-vite)
node_modules/
dist/
dist-ssr/
.vite/

