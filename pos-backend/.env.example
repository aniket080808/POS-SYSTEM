# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT Secret (use a strong random string, min 32 characters)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Mail Configuration (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Payment Gateways
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_API_KEY=your_stripe_secret_key
GEMINI_API_KEY=your_gemini_api_key

# Server
SERVER_PORT=5000

# Frontend URL (for password reset links)
FRONTEND_RESET_URL=http://localhost:5173/auth/reset-password?token=

# Admin Default Credentials (used for first-time initialization)
ADMIN_EMAIL_ANIKET=admin@example.com
ADMIN_PASSWORD_ANIKET=your_admin_password
ADMIN_FULL_NAME_ANIKET=Admin

# Logging Level
LOGGING_LEVEL_HIBERNATE_SQL=DEBUG
