# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT Secret (use a strong random string, min 32 characters)
JWT_SECRET=your-strong-random-secret-here-min-32-chars

# Mail Configuration (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Payment Gateways
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Server
SERVER_PORT=5000

# Frontend URL (for password reset links)
FRONTEND_RESET_URL=http://localhost:5173/auth/reset-password?token=

# Admin Default Credentials (used for first-time initialization)
ADMIN_EMAIL_ANIKET=admin@example.com
ADMIN_PASSWORD_ANIKET=ChangeMe123!
ADMIN_FULL_NAME_ANIKET=Super Admin

# Logging Level
LOGGING_LEVEL_HIBERNATE_SQL=DEBUG
